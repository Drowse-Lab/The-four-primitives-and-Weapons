## Based on GitHub's Eclipse .gitignore

*.md linguist-detectable=true



.claude/
node_modules/

run/
!run/**/*.nbt
!run/**/*.mcfunction
.nbt
.gradle/
gradle-app.setting

build/*
!build/libs/
build/libs/*
!build/libs/*.jar
run/
.gradle/
/libs/

## IntelliJ IDEA

.idea/
*.iml
*.iws
*.ipr

## Eclipse

eclipse/
*.pydevproject
.project
.metadata
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties
.classpath
.settings/
.loadpath

# External tool builders
.externalToolBuilders/

# Locally stored "Eclipse launch configurations"
*.launch

# CDT-specific
.cproject

# PDT-specific
.buildpath

.mcreator
.DS_Store
logs/sever
logs/function



# MCreator Lock Files
**/.mcreator_lock
.protected_custom_files/
*.backup_*

# Prevent MCreator regeneration
the_four_primitives_and_weapons.mcreator.lock

# ツールチップ角枠PNGはペイントで編集し、Gitで共有する設定アセット。
# run/ のその他のワールド・ログ・ユーザー設定は引き続き無視する。
!run/
run/*
!run/config/
run/config/*
!run/config/the_four_primitives_and_weapons/
run/config/the_four_primitives_and_weapons/*
!run/config/the_four_primitives_and_weapons/tooltip_corners/
!run/config/the_four_primitives_and_weapons/tooltip_corners/*.png
!run/config/the_four_primitives_and_weapons/tooltip_corners/README.txt
!run/config/the_four_primitives_and_weapons/tooltip_elements/
!run/config/the_four_primitives_and_weapons/tooltip_elements/*.png
