
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (jar)",
            "type": "shell",
            "command": "bash build.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$java"],
            "options": {
                "shell": {
                    "executable": "wsl.exe",
                    "args": ["-e", "bash", "-c"]
                },
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Clean Build (jar)",
            "type": "shell",
            "command": "bash build.sh clean",
            "group": "build",
            "problemMatcher": ["$java"],
            "options": {
                "shell": {
                    "executable": "wsl.exe",
                    "args": ["-e", "bash", "-c"]
                },
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Run Client",
            "type": "shell",
            "command": "bash run_client.sh",
            "group": "build",
            "problemMatcher": [],
            "options": {
                "shell": {
                    "executable": "wsl.exe",
                    "args": ["-e", "bash", "-c"]
                },
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Run Server",
            "type": "shell",
            "command": "./gradlew runServer",
            "group": "build",
            "problemMatcher": []
        }
    ]
}
